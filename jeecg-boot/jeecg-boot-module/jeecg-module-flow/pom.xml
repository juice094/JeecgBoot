<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>jeecg-boot-module</artifactId>
        <groupId>org.jeecgframework.boot3</groupId>
        <version>3.9.6</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>jeecg-module-flow</artifactId>
    <name>jeecg-module-flow</name>
    <description>流程域服务模块（Flowable 8.0.0 = Spring Boot 4 线；立项草案见 agent-collab-pilot/docs/27）</description>

    <properties>
        <!-- Flowable 8.0.0 是 Spring Boot 4 兼容线的起点（7.x 全线为 Boot 3），升级前重查官方 release note -->
        <flowable.version>8.0.0</flowable.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jeecgframework.boot3</groupId>
            <artifactId>jeecg-boot-base-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring-boot-starter-process</artifactId>
            <version>${flowable.version}</version>
        </dependency>
        <!-- 引擎单元测试需嵌入式数据库（Flowable 引擎无内存态，必须落库）；
             H2 为 Flowable 官方文档默认内存库，仅 test 作用域 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.3.232</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
