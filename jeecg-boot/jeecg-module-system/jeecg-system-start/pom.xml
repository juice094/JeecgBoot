<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>jeecg-module-system</artifactId>
        <groupId>org.jeecgframework.boot3</groupId>
        <version>3.9.6</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>jeecg-system-start</artifactId>

    <dependencyManagement>
        <dependencies>
            <!-- 统一 spring-ai 版本到 2.0.2。
                 jimureport-spring-boot4-starter 会传递 spring-ai-openai / client-chat 2.0.0，
                 其深度比 speech 模块的 2.0.2 更近，Maven 就近原则会让 2.0.0 胜出，
                 而 2.0.0 的 spring-ai-model 缺少 audio/transcription/observation 包，
                 导致 OpenAiAudioTranscriptionAutoConfiguration 创建 Bean 时 ClassNotFoundException。 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>2.0.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- SYSTEM 系统管理模块 -->
        <dependency>
            <groupId>org.jeecgframework.boot3</groupId>
            <artifactId>jeecg-system-biz</artifactId>
            <version>${jeecgboot.version}</version>
        </dependency>
        <!-- DEMO 示例模块 -->
        <dependency>
            <groupId>org.jeecgframework.boot3</groupId>
            <artifactId>jeecg-module-demo</artifactId>
            <version>${jeecgboot.version}</version>
        </dependency>
        <!-- SPEECH 模块 - 录音转写与 AI 会议纪要 -->
        <dependency>
            <groupId>org.jeecgframework.boot3</groupId>
            <artifactId>jeecg-module-speech</artifactId>
            <version>${jeecgboot.version}</version>
        </dependency>
        <!-- 团队协作业务模块（任务协作等，issue #2/#10） -->
        <dependency>
            <groupId>org.jeecgframework.boot3</groupId>
            <artifactId>jeecg-module-team</artifactId>
            <version>${jeecgboot.version}</version>
        </dependency>
        <!-- OA 邮件体系模块当前停用：模块仍保留在 aggregator 中独立编译，
             但不注册进 jeecg-system-start 运行时，避免 mailSyncScheduler 等未完成链路阻塞启动。 -->
        <!--
        <dependency>
            <groupId>org.jeecgframework.boot3</groupId>
            <artifactId>jeecg-module-mail</artifactId>
            <version>${jeecgboot.version}</version>
        </dependency>
        -->
        <!-- 流程域模块（Flowable 8.0.0 引擎）。
             副作用声明（W1-T4）：注册后下次启动引擎将自检并建/续 jeecg-boot 库 39 张 act_* 表
             （已存在则幂等跳过）；流程定义由 flow 模块编程式部署（FlowDeploymentConfig）。 -->
        <dependency>
            <groupId>org.jeecgframework.boot3</groupId>
            <artifactId>jeecg-module-flow</artifactId>
            <version>${jeecgboot.version}</version>
        </dependency>
        <!-- Word 文档同步业务（原独立 word-sync 工程，已合并为 Jeecg 模块） -->
        <dependency>
            <groupId>org.jeecgframework.boot3</groupId>
            <artifactId>jeecg-module-word-sync</artifactId>
            <version>${jeecgboot.version}</version>
        </dependency>
        
        <!-- flyway 数据库自动升级 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>7.15.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-properties-migrator</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
        </dependency>


        <!-- 分库分表示例 -->
     <!--  <dependency>
           <groupId>org.jeecgframework.boot3</groupId>
           <artifactId>jeecg-cloud-test-shardingsphere</artifactId>
           <version>3.9.6</version>
       </dependency>-->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.jeecg.JeecgSystemApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>